    "@flowforge/kernel": "workspace:*",
    "@flowforge/memory": "workspace:*",
    "@flowforge/packages": "workspace:*",
    "@flowforge/workflow": "workspace:*",
    "@xyflow/react": "^12.11.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.10.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
